# VHI_Website / Vercel Production environment.
# api.vidorckhair.com must be attached to the Render backend before redeploying.
NEXT_PUBLIC_SITE_URL=https://www.vidorckhair.com
NEXT_PUBLIC_API_URL=https://api.vidorckhair.com

# Match SESSION_COOKIE in the Render backend.
ADMIN_SESSION_COOKIE=vhi_demo_session

# Match REVALIDATE_SECRET in Render. This is a server-only secret.
REVALIDATE_SECRET=
