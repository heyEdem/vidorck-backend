# Render backend: use after attaching api.vidorckhair.com to this service.
# Preserve the existing Render APP_KEY. Generate one only for a new installation.
APP_NAME="Vidorck Hair Demo"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.vidorckhair.com

STOREFRONT_URL=https://www.vidorckhair.com
ADMIN_URL=https://www.vidorckhair.com/admin
CORS_ALLOWED_ORIGINS=https://www.vidorckhair.com,https://vidorckhair.com
SANCTUM_STATEFUL_DOMAINS=www.vidorckhair.com,vidorckhair.com

DB_CONNECTION=sqlite
DB_DATABASE=/var/data/database.sqlite
LARAVEL_STORAGE_PATH=/var/data/storage
PORT=10000

SESSION_DRIVER=database
SESSION_COOKIE=vhi_demo_session
SESSION_DOMAIN=.vidorckhair.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Demo notifications are logged instead of delivered.
MAIL_MAILER=log
SMS_DRIVER=log

# Use Paystack test keys when enabling demo checkout.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://www.vidorckhair.com/checkout/return

# Must match REVALIDATE_SECRET in Vercel; use the canonical host to avoid redirects.
STOREFRONT_REVALIDATE_URL=https://www.vidorckhair.com/api/revalidate
REVALIDATE_SECRET=

# Recreates the first Admin on each start (the demo database resets without a disk).
# Keep these set; password changes made in the app are lost on the next reset.
BOOTSTRAP_ADMIN_NAME="Vidorck Admin"
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
