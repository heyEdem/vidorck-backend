# Application (production: APP_ENV=production, APP_DEBUG=false, HTTPS APP_URL)
APP_NAME="Vidorck Hair API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GH
APP_MAINTENANCE_DRIVER=file

# JSON daily logs, retained for 14 days. Never log credentials or payment payloads.
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Omit DB_DATABASE to use database/database.sqlite; an override must be absolute.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_COOKIE=vhi_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Production: SESSION_DOMAIN=.vidorckhair.com (API on api.vidorckhair.com), SESSION_SECURE_COOKIE=true
# Hosts (no scheme) whose browser calls to /api/v1/admin/* use cookie sessions. :3100 is Playwright.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3100
# Production: SANCTUM_STATEFUL_DOMAINS=vidorckhair.com
HASH_DRIVER=argon2id
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

# Canonical storefront URL (Paystack callback and email links). One URL, no trailing slash.
STOREFRONT_URL=http://localhost:3000
# Exact CORS origins, comma-separated. Defaults to STOREFRONT_URL. :3100 is Playwright.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
# Link base for staff notification links (not a CORS origin). The admin lives on the storefront origin.
ADMIN_URL=http://localhost:3000/admin
# Production: STOREFRONT_URL=https://vidorckhair.com, CORS_ALLOWED_ORIGINS=https://vidorckhair.com, ADMIN_URL=https://vidorckhair.com/admin

# Phase 3: Paystack. Use test credentials locally and in staging.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3000/checkout/return

# Phase 5: Resend email. MAIL_MAILER=log locally; resend in production.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@vidorckhair.com
MAIL_FROM_NAME="Vidorck Hair"
MAIL_REPLY_TO_ADDRESS=
MAIL_LOGO_URL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
# Staging delivery allowlist (comma-separated addresses).
MAIL_ALLOWED_RECIPIENTS=

# Phase 5: SMS. SMS_DRIVER is log (local), arkesel or smsonlinegh.
SMS_DRIVER=log
ARKESEL_API_KEY=
ARKESEL_BASE_URL=https://sms.arkesel.com
ARKESEL_SENDER_ID=VIDORCK
# SMSOnlineGH (Zenoph SDK, API key auth over HTTPS). Sender ID must be registered on the account.
SMSONLINEGH_API_KEY=
SMSONLINEGH_HOST=api.smsonlinegh.com
SMSONLINEGH_SENDER_ID=VIDORCKHAIR
# Staging SMS delivery allowlist (comma-separated E.164 numbers).
SMS_ALLOWED_RECIPIENTS=

# Phase 2: storefront cache revalidation, shared only with Next.js.
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Prefer REVALIDATE_SECRET; STOREFRONT_REVALIDATE_SECRET remains a compatibility fallback.
REVALIDATE_SECRET=
STOREFRONT_REVALIDATE_SECRET=

# Phase 7: Litestream/rclone backup service configuration; not read by Laravel.
# Separate credentials, bucket/prefix and SQLite path for staging and production.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
B2_ENDPOINT=
B2_BUCKET=
B2_DATABASE_PREFIX=local/database
B2_MEDIA_PREFIX=local/media

# Dev-only staff seeds (php artisan db:seed; ignored outside local/testing)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
